# Copy to `.env` and fill in real values. NEVER commit `.env` itself.
#
#   cp .env.example .env
#
# `.env` is already listed in .gitignore. Verify with:
#   git check-ignore -v .env

# ---------------------------------------------------------------------------
# GitHub API token used by the sprint automation
# (scripts/gh_api.py, scripts/daily_pr.py) to open issues and pull requests.
#
# Required permission layer for this repository:
#   Repository admin — needed to manage CI, Pages, Dependabot and releases.
#
# Generate one at:
#   https://github.com/settings/personal-access-tokens/new
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# Optional: the same token under the name the GitHub CLI prefers.
GH_TOKEN=

# ---------------------------------------------------------------------------
# Optional: override the token used by the scheduled daily workflow, when the
# default workflow GITHUB_TOKEN cannot push branches or open PRs (branch
# protection). Set this as an Actions *secret*, not as a committed file.
# ---------------------------------------------------------------------------
# DAILY_PR_TOKEN=

# ---------------------------------------------------------------------------
# Optional: GitHub repository in owner/name form, overriding origin.
# ---------------------------------------------------------------------------
# GITHUB_REPOSITORY=fufurobot/myjupyter
